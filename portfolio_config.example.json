{
  "settings": {
    "days_price_history": "3mo",
    "min_history_bars": 14,
    "stale_days": 7,
    "buy_probability_threshold": 45,
    "sell_probability_threshold": 55,
    "action_add_margin": 5,
    "action_reduce_margin": 5,
    "action_tech_floor": 45,
    "action_hold_band": 10,
    "rsi_overbought": 70,
