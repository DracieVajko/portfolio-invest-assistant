# ==========================================
# Trading212 API Credentials
# ==========================================
# Obtain your read-only credentials from Trading212 -> Settings -> API
# Never commit real keys. Copy this file to api.env and fill locally.

TRADING212_ENABLED=true
TRADING212_API_BASE=https://live.trading212.com

TRADING212_API_KEY=
TRADING212_API_SECRET=

# Account ID (optional)
TRADING212_ACCOUNT_ID=

# ==========================================
# Portfolio Settings
# ==========================================
# Optional tunables for API throttling and caching

TRADING212_RATE_LIMIT=50
TRADING212_CACHE_TTL=300

# ==========================================
# Ollama — Local LLM (Windows native, fallback)
# ==========================================
# Example local endpoint for Ollama. Change only if you use a custom host/model.

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=plutus:latest
OLLAMA_CONTEXT_TOKENS=

# ==========================================
# LM Studio — Local OpenAI-Compatible API
# ==========================================
# Used as primary provider in v1.0.0. Leave empty if you use Ollama only.

LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=

# ==========================================
# OpenRouter — Optional Remote LLM Provider
# ==========================================
# Only needed if you enable OpenRouter fallback. Never commit real keys.

OPENROUTER_API_KEY=
OPENROUTER_API_KEY_ALT=

# ==========================================
# Odysseus — Optional Custom Service
# ==========================================
# Optional internal service endpoint. Leave empty if not used.

ODYSSEUS_URL=http://localhost:7000
