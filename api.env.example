# Example environment file — copy to api.env and fill in real values.
#   copy api.env.example api.env   (Windows) / cp api.env.example api.env (POSIX)
# api.env is gitignored and must never be committed. All values below are
# placeholders and intentionally non-functional.
#
# Fallback chain (EXECUTION_MODE=auto, the default):
#   LM Studio -> llama.cpp (Pi, strongest fine-tuned) -> Ollama (Pi, big ctx)
#   -> Gemini -> OpenRouter (:free models only) -> Mistral -> deterministic.
# Production endpoints (kept as loopback placeholders here on purpose —
# put the real values in api.env, which is gitignored):
#   LM Studio  http://100.88.219.120:1234/v1
#   llama.cpp  http://100.125.47.31:11435/v1
#   Ollama     http://100.125.47.31:11434

# --- Trading 212 (read-only integration reads these) ---
TRADING212_API_KEY=paste-your-trading212-api-key-here
TRADING212_API_SECRET=paste-your-trading212-api-secret-here
TRADING212_ACCOUNT_ID=paste-your-trading212-account-id-here

# --- Provider selection ---
# auto = full chain above. public = cloud only. locals = locals + deterministic.
PROVIDER=auto
EXECUTION_MODE=auto
LMSTUDIO_ENABLED=1

# --- Local models (no keys needed) ---
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=placeholder-local-model
LLAMACPP_BASE_URL=http://127.0.0.1:11435/v1
LLAMACPP_MODEL=placeholder-llamacpp-model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=placeholder-ollama-model

# --- Cloud fallback keys (empty = provider skipped) ---
# Order after locals: Gemini -> OpenRouter(:free only) -> Mistral.
GEMINI_API_KEY=
GEMINI_MODEL=placeholder-gemini-model
OPENROUTER_API_KEY=
OPENROUTER_MODEL=placeholder-openrouter-free-model
MISTRAL_API_KEY=
MISTRAL_MODEL=placeholder-mistral-model
OPENCODE_ZEN_API_KEY=

# --- Model routing (placeholders; real defaults live in code/config) ---
DECISION_MODEL=placeholder-decision-model
WRITER_MODEL=placeholder-writer-model
FINANCE_MODEL=placeholder-finance-model
THINKING_MODEL=placeholder-thinking-model
LOCAL_FALLBACK_MODEL=placeholder-local-fallback-model
