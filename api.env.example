# Copy to api.env and fill in your own values. NEVER commit api.env.
# All *_BASE_URL values below are neutral localhost placeholders;
# point them at your own machines (LAN/Tailscale) as needed.

# Trading212 (read-only API pair from Trading212 -> Settings -> API)
TRADING212_ENABLED=true
TRADING212_API_BASE=https://live.trading212.com
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ACCOUNT_ID=
TRADING212_RATE_LIMIT=50
TRADING212_CACHE_TTL=300

# Optional services
ODYSSEUS_URL=

# LM Studio (OpenAI-compatible, primary local provider)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_CONTEXT_TOKENS=32768
LM_STUDIO_MAX_OUTPUT_TOKENS=8192
REQUEST_TIMEOUT_SECONDS=1800

# Stage models (reasoning vs summary; see investment_engine/providers/presets.py)
DECISION_MODEL=
WRITER_MODEL=
FALLBACK_MODEL=openrouter/free
PROVIDER=auto

# llama.cpp (secondary local endpoint)
# LLAMACPP_BASE_URL=http://127.0.0.1:11435/v1
# LLAMACPP_MODEL=

# Ollama (tertiary local endpoint)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_CONTEXT_TOKENS=128000

# Cloud fallbacks (keys stay empty unless you use them)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_ALT=
OPENROUTER_GROK_MODEL=x-ai/grok-3-mini
OPENROUTER_CONTEXT_TOKENS=62000
OPENROUTER_MAX_OUTPUT_TOKENS=8192

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

MISTRAL_API_KEY=
MISTRAL_MODEL=open-mistral-nemo
MISTRAL_BASE_URL=https://api.mistral.ai/v1

OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=opencode-zen-free
OPENCODE_ZEN_BASE_URL=https://api.opencode.ai/v1
